;Equipes dos Estabelecimentos de Saúde do CNES
;
;**************************************************************************
;
AEQUIPE\EP*.DBC
?.\HELP\EQUIPE.HLP
;
IAtende Quilombolas?, QUILOMBO
IAtende Assentados?, ASSENTAD
IAtende Popupalação Geral?, POPGERAL
IAtende Escola?    , ESCOLA
IAtende Indigena?  , INDIGENA
IAtende PRONASCI?  , PRONASCI
;
;**************************************************************************
;*> DADOS REFERENTES A EQUIPES
X* DADOS das EQUIPES * , TITULO     , 1 , DADOS_REFERENTES_A_EQUIPES
XPopulacão Assistida, QUILOMBO      , DS_POP , DBF\POPULAC.DBF
XMês de Ativação   , DT_ATIVA       , 1 , CNV\COMPT.CNV
XMês de Ativação, DT_DESAT          , 1 , CNV\COMPT.CNV
XMotivo Desativação, MOTDESAT       , 1 , CNV\MOTDESAT.CNV
XTipo de Desativação, TP_DESAT      , 1 , CNV\TP_DESAT.CNV
DTipo da Equipe    , TIPO_EQP   , DS_EQUIPE , DBF\EQUIPE.DBF
STipo da Equipe    , TIPO_EQP   , DS_EQUIPE , DBF\EQUIPE.DBF
CTipo da Equipe    , TIPO_EQP       , 1 , CNV\TIPOEQPc.CNV
XTipo do Segmento  , TIPOSEGM       , 1 , CNV\TIPOSEGM.CNV
;
;
;**************************************************************************
; CASO DESEJE UTILIZAR UM ARQUIVO DE NOME "EQUIPES.CNV", COM OS NOMES E
; CËDIGOS DAS EQUIPES DO MUNICÍPIO,RETIRE O ";" DO INÍCIO DA PRËXIMA LINHA.
;XCódigo/Nome Equipe,IDEQUIPE,  1, EQUIPES.CNV
;**************************************************************************
;**************************************************************************
; CASO DESEJE UTILIZAR UM ARQUIVO DE NOME "AREAS.CNV", COM OS NOMES E
; CËDIGOS DAS AREAS DO MUNICÍPIO, RETIRE O ";" DO INÍCIO DA PRËXIMA LINHA
;XCód./Nome da Area, ID_AREA,   1, AREAS.CNV
;**************************************************************************
; CASO DESEJE UTILIZAR UM ARQUIVO DE NOME "SEGMENTO.CNV",
; COM OS NOMES E CËDIGOS DOS SEGMENTOS DO MUNICÍPIO,
; RETIRE O ";" DO INÍCIO DA PRËXIMA LINHA
;XCód./Desc.Segmento,COD_SEGM,  1, SEGMENTO.CNV
;**************************************************************************
;**************************************************************************
; CASO O GESTOR MUNCÍPAL CONSTRUA OS ARQUIVOS "EQUIPES.CNV", "AREAS.CNV" e
;"SEGMENTO.CNV", ELES DEVEM ER ACRESCIDOS, MENSALMENTE, DAS INCLUSÕES DE EQUIPES,
;ÁREAS E SEGMENTOS FEITAS NA COMPETÊNCIA
;***************************************************************************
; ATENÇÃO: REAPROVEITAMENTO DE CÓDIGOS, COM MUDANÇA DE DESCRIÇÃO,
;          GERARÃO INCONSISTÊNCIAS AO LONGO DA SÉRIE HISTÓRICA
;***************************************************************************
;
;
;
X* EQUIPES_AC *,    , TITULO , TITULO_REFERENTES_A_EQUIPES_DO_UF
XCódigo Equipe AC,   IDEQUIPE, ID_EQUIPE,DBF\EQP_AC.DBF
XNome Equipe AC,     IDEQUIPE, NOME_EQP, DBF\EQP_AC.DBF
XCódigo Área Equipe AC,  ID_AREA,  ID_AREA,  DBF\AREA_AC.DBF
XNome Área Equipe AC,  ID_AREA,  NOMEAREA, DBF\AREA_AC.DBF
XCódigo Segmento AC, ID_SEGM,  ID_SEGM,  DBF\SEGM_AC.DBF
XNome Segmento AC,   ID_SEGM,  DESCSEGM, DBF\SEGM_AC.DBF
;
