XRetenção Tributos MANTENEDORA,  COD_IR,    1, CNV\RETENMAN.CNV
XNível Hierarquia,   NIV_HIER,              1, CNV\NIV_HIER.CNV
XEsfera Administrativa, ESFERA_A,           1, CNV\EsferAdm.cnv
XAtividade Ensino/Pesquisa,  ATIVIDAD,      1, CNV\Ativ_Ens.CNV
XTipo de Estabelecimento, TP_UNID,          1, CNV\TP_ESTAB.CNV
XTurno Atendimento,  TURNO_AT,              1, CNV\TurnosAt.cnv
XTipo de Prestador,  TP_PREST,              1, CNV\TIPOPRES.CNV
;
;=>  Vínculos com o SUS do LFCES011
X* VÍNCULOS *,         COMENTARIO,1, VÍNCULOS
XVínculos com SUS,   VINC_SUS,              1, CNV\VINC_SUS.CNV
;
;Manten.por CNPJ,    CNPJ_MAN,  1, (FALTA gerar DBF de MANTENEDORAS com nomes e CNPJ)
;===========================================================================================
; Características do Serviço de Diálise do LFCES012
;===========================================================================================
