;Incentivos dos Estabelecimentos de Saúde do CNES - Março de 2007 em diante
;==================================================================================
;
AINCENTIV\IN*.DB?
;
;=> DADOS REFERENTES A INCENTIVOS
XIncentivos        ,  SGRUPHAB  ,  DS_INCEN, INCENTIVOS.DBF
X* DADOS PORTARIA ,  COMENTARIO,1, DADOS_REFERENTES_À_REGRAS_CONTRATUAIS
XMês de Publicação,  MAPORTAR,  1, CNV\COMPT.CNV
XCompetência Inicio, CMPT_INI,  1,CNV\COMPT.CNV
XCompetência Fim,    CMPT_FIM,  1, CNV\COMPT.CNV
;
X* DADOS GERAIS,      COMENTARIO,1, DADOS GERAIS_ESTABELECIMENTOS
;=>  Competência da EXTRAÇÃO DO BANCO
XMês de Competência, COMPETEN,  1, CNV\COMPETEN.CNV
;
;=>  Dados do estabelecimento do LFCES004, e de mantenedora do LFCES005
XTipo de Gestão,     TPGESTAO,  1, CNV\TPGESTAO.CNV
XMantida/Individual, NIV_DEP,   1, CNV\NIVELDEP.CNV
XPessoa Fis./Juríd., PF_PJ,     1, CNV\TP_PFPJ.CNV
XÉ Terceiro?,        TERCEIRO,  1, CNV\TERCEIRO.CNV
;Fluxo Clientela,    CLIENTEL,  1, CNV\FLUX_CLI.CNV
XNatureza da Organz, NATUREZA,  1, CNV\NATUREZA.CNV
XRet.Tribut.ESTAB.,  RETENCAO,  1, CNV\RETENCAO.CNV
XNível Hierarquia,   NIV_HIER,  1, CNV\NIV_HIER.CNV
XEsfera Administiva, ESFERA_A,  1, CNV\EsferAdm.cnv
XAtiv. Ensino/Pesq,  ATIVIDAD,  1, CNV\Ativ_Ens.CNV
XTipo de Estabelec., TP_UNID,   1, CNV\TP_ESTAB.CNV
XTurno Atendimento,  TURNO_AT,  1, CNV\TurnosAt.cnv
XTipo de Prestador,  TP_PREST,  1, CNV\TIPOPRES.CNV
;Manten.por CNPJ,    CNPJ_MAN,  1, (FALTA gerar DBF de MANTENEDORAS com nomes e CNPJ)
;
;=>  Vínculos com o SUS do LFCES011
X* VÍNCULOS,         COMENTARIO,1, VÍNCULOS
XVínculos com SUS,   VINC_SUS,  1, CNV\VINC_SUS.CNV
;
;
;;=>  MUNICÍPIOS - SEGUNDO O IBGE
X* LOCALIZAÇÃO *,    COMENTARIO,1, LOCALIZAÇÃO_ESTABELECIMENTO
LRegião,                        CODUFMUN,1 , CNV\br_regiao.cnv
CRegião,                        CODUFMUN,1 , CNV\br_regiao.cnv
SRegião,                        CODUFMUN,1 , CNV\br_regiao.cnv
