;Cadastro Nacional dos Estabelecimentos de Saúde do CNES
;===========================================================================================
;
AESTABEL\ST*.DB?
?ESTABELECIMENTO_ST_NOVO.HLP
;
;===========================================================================================
;Variáveis referentes aos Dados Gerais dos Estabelecimentos
;===========================================================================================
X* DADOS GERAIS *,      TITULO,LINHA_COMENTARIO_DADOS GERAIS_DOS_ESTABELECIMENTOS
;=>  DATA_ATUALIZAÇÃO_Mês/Ano da Informação/Competência da EXTRAÇÃO DO BANCO
;XMês de Atualização, DT_ATUAL,  1, CNV\ANO_MES.CNV
XMês de Competência, COMPETEN,   1, CNV\COMPETEN.CNV
;XMotivo Desativação, MOTDESAB,  1, CNV\MOTD_EST.CNV
XTipo de Gestão,     TPGESTAO,   1, CNV\TPGESTAO.CNV
XMantida/Individual, NIV_DEP,    1, CNV\NIVELDEP.CNV
XPessoa Físicas/Jurídica , PF_PJ,1, CNV\TP_PFPJ.CNV
;XÉ Terceiro?,       TERCEIRO,   1, CNV\TERCEIRO.CNV
XFluxo Clientela,    CLIENTEL,   1, CNV\FLUX_CLI.CNV
XNatureza da Organização, NATUREZA,   1, CNV\NATUREZA.CNV
LNatureza Jurídica, NAT_JUR ,    1, CNV\NATJUR.CNV
CNatureza Jurídica, NAT_JUR ,    1, CNV\NATJURC.CNV
SNatureza Jurídica, NAT_JUR ,    1, CNV\NATJURC.CNV
LEsfera Jurídica,   NAT_JUR ,    1, CNV\ESFERAJUR.CNV
CEsfera Jurídica,   NAT_JUR ,    1, CNV\ESFERAJURC.CNV
SEsfera Jurídica,   NAT_JUR ,    1, CNV\ESFERAJURC.CNV
XRetenção Tributos Estabel.,  RETENCAO,   1, CNV\RETENCAO.CNV
XRetenção Tributos Mantenedora,  COD_IR,  1, CNV\RETENMAN.CNV
XNível Hierarquia,   NIV_HIER,   1, CNV\NIV_HIER.CNV
XEsfera Administrativa, ESFERA_A,1, CNV\EsferAdm.cnv
XAtividade Ensino/Pesquisa,  ATIVIDAD,    1, CNV\Ativ_Ens.CNV
XTipo de Estabelecimento,TP_UNID,1, CNV\TP_ESTAB.CNV
XTurno Atendimento,  TURNO_AT,   1, CNV\TurnosAt.cnv
XTipo de Prestador,  TP_PREST,   1, CNV\TIPOPRES.CNV
;Manten.por CNPJ,    CNPJ_MAN,   1, (FALTA gerar DBF de MANTENEDORAS com nomes e CNPJ)
XMês/Ano Expedição Alvará, DT_EXPED,   1, CNV\ANO_MES.CNV
XÓrgão Expedição Alvará,   ORGEXPED,   1, CNV\ORGEXPED.CNV
;===========================================================================================
;                      Avaliação de Acreditação é só para Hospitais
;===========================================================================================
XAvaliação Acreditação?,  AV_ACRED,  1, CNV\AVALIADO.CNV
XClasse Avaliação,   CLASAVAL,  1, CNV\CLASAVAL.CNV
;
;=>  Vínculos com o SUS do LFCES011
X* VÍNCULOS *,         COMENTARIO,1, VÍNCULOS
XVínculos com SUS,   VINC_SUS,  1, CNV\VINC_SUS.CNV
XMês/Ano Publicação Contr. MUN,DT_PUBLM,  1, CNV\ANO_MES.CNV
XMês/Ano Publicação Contr. EST,DT_PUBLE,  1, CNV\ANO_MES.CNV
